# Отдаёт статику MyApplication.Web.UI и проксирует API-запросы на API —
# единый origin для браузера, без CORS.
#
# Шаблон (не готовый конфиг): образ nginx:1.27-alpine сам прогоняет любой
# файл из /etc/nginx/templates/*.template через envsubst при старте
# контейнера, подставляя реальные значения переменных окружения, и кладёт
# результат в /etc/nginx/conf.d/ (см. ci/Dockerfile.web-ui). Нужно это
# потому, что адрес API отличается между окружениями: в Docker Compose
# сервисы видят друг друга по имени контейнера (myapplication-api:8080,
# см. ENV в Dockerfile.web-ui), а в Railway — по приватному DNS вида
# `<service>.railway.internal:<port>`, который известен только на этапе
# деплоя. $PORT — тоже переменная окружения (стандарт Railway для
# публичных сервисов — платформа сама решает, на каком порту к ним
# обращаться, и передаёт его в PORT), а не nginx-переменная — не путать с
# `$uri`/`$host`/`$scheme` ниже, которые остаются как есть: envsubst
# подставляет только реальные ОС-переменные (нет такой ОС-переменной,
# например, `$host`), так что синтаксис самого nginx не ломается.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Заметка по бизнес-правилам (business-rules.md) может содержать текст до
    # 1 МБ — с учётом JSON-обвязки (заголовок, ключи, кавычки) тело запроса
    # может чуть превысить дефолтный лимит nginx (ровно 1m), и создание/правка
    # заметки на границе лимита падала бы с 413 ещё до API. Берём с запасом.
    client_max_body_size 2m;

    location / {
        try_files $uri /index.html;
    }

    location /Notes {
        proxy_pass http://${API_INTERNAL_ADDRESS};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Тот же origin нужен и для refresh-cookie (httpOnly, ставится API на
    # /Auth) — иначе браузер не будет её отправлять обратно.
    location /Auth {
        proxy_pass http://${API_INTERNAL_ADDRESS};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
