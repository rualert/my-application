# Многоэтапная сборка MyApplication.Web.UI: сначала статика собирается Vite,
# затем отдаётся nginx. Контекст сборки — корень репозитория (см. compose-файлы,
# использующие этот Dockerfile), поэтому все пути ниже — от корня.

FROM node:22-alpine AS build
WORKDIR /app
COPY src/MyApplication.Web.UI/package.json src/MyApplication.Web.UI/package-lock.json src/MyApplication.Web.UI/.npmrc ./
RUN npm ci --global=false
COPY src/MyApplication.Web.UI/ ./
# Vite встраивает VITE_-переменные окружения в статику на этапе сборки —
# ARG сам по себе не виден в RUN, поэтому явно прокидывается в ENV.
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# .template + templates/ — образ nginx сам прогонит файл через envsubst при
# старте контейнера (см. комментарий в самом файле). Дефолты ниже — для
# Docker Compose (docker-compose.app.yml слушает 80 на хосте и резолвит имя
# сервиса myapplication-api по сети elastic); в Railway обе переменные
# переопределяются реальными значениями (PORT — платформой автоматически,
# API_INTERNAL_ADDRESS — вручную, приватным DNS-адресом сервиса API).
COPY ci/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=80
ENV API_INTERNAL_ADDRESS=myapplication-api:8080
EXPOSE 80
