# Многоэтапная сборка MyApplication.Web.UI: сначала статика собирается Vite,
# затем отдаётся nginx. Контекст сборки — корень репозитория (см. compose-файлы,
# использующие этот Dockerfile), поэтому все пути ниже — от корня.

FROM node:22-alpine AS build
WORKDIR /app
COPY src/MyApplication.Web.UI/package.json src/MyApplication.Web.UI/package-lock.json src/MyApplication.Web.UI/.npmrc ./
RUN npm ci --global=false
COPY src/MyApplication.Web.UI/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY ci/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
