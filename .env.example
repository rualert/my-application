# Секреты для ci/docker-compose.app.yml. Скопируйте в .env (в этом же
# каталоге — корне репозитория) и заполните реальными значениями; .env не
# коммитится (см. .gitignore). Docker Compose подхватывает такой файл
# автоматически при запуске из корня репозитория.

# Google OAuth 2.0 Client ID (Web application) из Google Cloud Console —
# не секрет сам по себе, но конкретное значение зависит от окружения.
GOOGLE_CLIENT_ID=

# Ключ подписи собственных JWT (не Google) — настоящий секрет, сгенерируйте
# случайную строку (32+ байта).
JWT_SIGNING_KEY=
